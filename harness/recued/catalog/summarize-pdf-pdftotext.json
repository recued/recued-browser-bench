{"recipe_id":"summarize-pdf-pdftotext","publisher_id":"recued-core","version":2,"recipe":{"ttl":60,"steps":[{"id":"extract","op":"recued-core.pdftotext.pdf.to_text","args":{"source":"{{config.source}}"}},{"id":"text_ref","value":"{{step.extract.file_ref}}","fallback":"","transform":"default"},{"id":"has_text","left":"{{step.text_ref}}","operator":"is_not_empty","transform":"compare"},{"id":"summarize","op":"core.ai.summarize","args":{"llm.data":{"file_ref":"{{step.text_ref}}"},"llm.focus":"{{config.focus}}","llm.max_length":"{{config.max_length}}","llm.model_hint":"fast"},"skip_when":"{{step.has_text}} not_equal true"},{"id":"defaults","fields":{"summary":{"value":"{{step.summarize.summary}}","fallback":""},"key_points":{"value":"{{step.summarize.key_points}}","fallback":[]}},"transform":"defaults"},{"id":"key_points_count","input":"{{step.key_points}}","transform":"count"},{"id":"key_points_text","array":"{{step.key_points}}","separator":"\n","transform":"join"},{"id":"now","date":"now","unit":"days","amount":0,"transform":"date_add"},{"id":"skip_write","transform":"any","conditions":["{{step.has_text}} not_equal true","{{config.write_mode}} not_equal stage"]},{"id":"keep_text","op":"core.storage.file.persist","args":{"ref":"{{step.text_ref}}"},"skip_when":"{{step.skip_write}} equal true"},{"id":"row_key","all":true,"input":"{{step.keep_text.cas_ref}}","pattern":":","skip_when":"{{step.skip_write}} equal true","transform":"replace","replacement":"_"},{"id":"stage_row","op":"core.storage.shared.write","args":{"key":"data.shared.{{config.staging_prefix}}.{{step.row_key}}","value":{"kind":"pdf_note","state":"staged","title":"{{config.title}}","source":"{{config.source}}","summary":"{{step.summary}}","staged_at":"{{step.now}}","key_points":"{{step.key_points}}","extracted_text_ref":"{{step.keep_text.cas_ref}}"}},"skip_when":"{{step.skip_write}} equal true"},{"id":"staged","input":"{{step.skip_write}}","transform":"not"},{"id":"card","fields":[{"label":"Title","value":"{{config.title}}"},{"label":"Source","value":"{{config.source}}"},{"label":"Write mode","value":"{{config.write_mode}}"},{"label":"Staged text file","value":"{{step.keep_text.cas_ref}}"},{"label":"Summary","value":"{{step.summary}}"},{"label":"Key points","value":"{{step.key_points_text}}"},{"label":"Key point count","value":"{{step.key_points_count:number}}"},{"label":"Staged","value":"{{step.staged}}"},{"label":"Posture","value":"Preview-first. Set write_mode to stage to persist a durable PDF note; the extracted text stays behind a file ref."}],"transform":"to_summary"}],"output":{"render":[{"type":"summary","source":"step.card"}]},"version":2,"metadata":{"name":"Summarize PDF with PDFToText","tags":["pdftotext","pdf","document","summary","notes","research","staging","pack:pdftotext","ai_surface"],"author":"recued-core","budget_ms":150000,"description":"Use “Summarize PDF with PDFToText” in Recued. Extract text from one trusted PDF through the local Poppler pdftotext CLI, then summarize the extracted text through a Gateway-gated file ref.","variant_group":"summarize-pdf-pdftotext","supported_platforms":[]},"requires":[],"recipe_id":"summarize-pdf-pdftotext","variables":{"focus":{"type":"string","label":"Summary focus","default":"main points, decisions, dates, obligations, risks, and follow-up actions"},"title":{"type":"string","label":"Document title","default":""},"source":{"type":"string","label":"Source PDF path or file ref"},"max_length":{"type":"number","label":"Summary length (words)","default":300},"write_mode":{"type":"enum","label":"Write mode","default":"preview","options":["preview","stage"]},"staging_prefix":{"type":"string","label":"Staging collection prefix","default":"pdf_notes_staging"}},"depends_on":["recued-core.pdftotext"],"chat_exposed":true}}